From 88458ff8e359cca69ca61daf3f6736121be83c93 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 16 Oct 2026 07:36:24 +0000
Subject: [PATCH] WASM/QuickJS port: add ARCH_WASM, adapt error reporting and
 generator helper

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01V1KTZf1EfjbXMf1biK2Kv5
---
 source/lib/sysdep/arch.h                    |  9 ++++++-
 source/scriptinterface/FunctionWrapper.h    |  4 +--
 source/scriptinterface/ScriptExceptions.cpp | 30 +++++++++++----------
 3 files changed, 26 insertions(+), 17 deletions(-)

diff --git a/source/lib/sysdep/arch.h b/source/lib/sysdep/arch.h
index 74550970..c799a104 100644
--- a/source/lib/sysdep/arch.h
+++ b/source/lib/sysdep/arch.h
@@ -83,8 +83,15 @@
 # define ARCH_E2K 0
 #endif
 
+// .. WebAssembly (Emscripten port)
+#if defined(__wasm__) || defined(__EMSCRIPTEN__)
+# define ARCH_WASM 1
+#else
+# define ARCH_WASM 0
+#endif
+
 // ensure exactly one architecture has been detected
-#if (ARCH_IA32+ARCH_IA64+ARCH_AMD64+ARCH_ALPHA+ARCH_ARM+ARCH_AARCH64+ARCH_MIPS+ARCH_E2K+ARCH_PPC64) != 1
+#if (ARCH_IA32+ARCH_IA64+ARCH_AMD64+ARCH_ALPHA+ARCH_ARM+ARCH_AARCH64+ARCH_MIPS+ARCH_E2K+ARCH_PPC64+ARCH_WASM) != 1
 # error "architecture not correctly detected (either none or multiple ARCH_* defined)"
 #endif
 
diff --git a/source/scriptinterface/FunctionWrapper.h b/source/scriptinterface/FunctionWrapper.h
index 32ad5edb..1ccd24d2 100644
--- a/source/scriptinterface/FunctionWrapper.h
+++ b/source/scriptinterface/FunctionWrapper.h
@@ -380,11 +380,11 @@ public:
 				return iteratorResult;
 			};
 
-		JS::PersistentRootedValue error{rq.cx, JS::UndefinedValue()};
+		JS::RootedValue error{rq.cx, JS::UndefinedValue()};
 		while (true)
 		{
 			JS::RootedValue iteratorResult{rq.cx, error.isUndefined() ? continueGenerator("next") :
-				continueGenerator("throw", std::exchange(error, JS::UndefinedValue()))};
+				continueGenerator("throw", [&] { JS::Value old = error; error = JS::UndefinedValue(); return old; }())};
 
 			try
 			{
diff --git a/source/scriptinterface/ScriptExceptions.cpp b/source/scriptinterface/ScriptExceptions.cpp
index eb8cbeda..1f84ef1c 100644
--- a/source/scriptinterface/ScriptExceptions.cpp
+++ b/source/scriptinterface/ScriptExceptions.cpp
@@ -55,9 +55,15 @@ bool ScriptException::CatchPending(const ScriptRequest& rq)
 	}
 
 	JS::RootedObject excnObj(rq.cx, &excn.toObject());
-	JSErrorReport* report = JS_ErrorFromException(rq.cx, excnObj);
 
-	if (!report)
+	// QuickJS port: error details are plain properties of the Error object.
+	JS::RootedValue messageVal(rq.cx), fileVal(rq.cx), lineVal(rq.cx), stackVal(rq.cx);
+	JS_GetProperty(rq.cx, excnObj, "message", &messageVal);
+	JS_GetProperty(rq.cx, excnObj, "fileName", &fileVal);
+	JS_GetProperty(rq.cx, excnObj, "lineNumber", &lineVal);
+	JS_GetProperty(rq.cx, excnObj, "stack", &stackVal);
+
+	if (messageVal.isUndefined())
 	{
 		CStr error;
 		Script::FromJSVal(rq, excn, error);
@@ -67,22 +73,18 @@ bool ScriptException::CatchPending(const ScriptRequest& rq)
 
 	std::stringstream msg;
 	msg << "JavaScript error: ";
-	if (report->filename)
+	CStr file, message, stackText;
+	if (!fileVal.isUndefined() && Script::FromJSVal(rq, fileVal, file) && !file.empty())
 	{
-		msg << report->filename;
-		msg << " line " << report->lineno << "\n";
+		int line = 0;
+		Script::FromJSVal(rq, lineVal, line);
+		msg << file << " line " << line << "\n";
 	}
+	Script::FromJSVal(rq, messageVal, message);
+	msg << message;
 
-	msg << report->message().c_str();
-
-	JS::RootedObject stackObj(rq.cx, ExceptionStackOrNull(excnObj));
-	JS::RootedValue stackVal(rq.cx, JS::ObjectOrNullValue(stackObj));
-
-	if (!stackVal.isNull())
+	if (!stackVal.isUndefined() && Script::FromJSVal(rq, stackVal, stackText))
 	{
-		std::string stackText;
-		ScriptFunction::Call(rq, stackVal, "toString", stackText);
-
 		std::istringstream stream(stackText);
 		for (std::string line; std::getline(stream, line);)
 			msg << "\n  " << line;
-- 
2.43.0


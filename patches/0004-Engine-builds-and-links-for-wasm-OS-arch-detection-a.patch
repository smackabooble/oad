From c51a22abcb56d62aa1646797e9349e142d12e24d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 16 Oct 2026 09:26:31 +0000
Subject: [PATCH 4/4] Engine builds and links for wasm: OS/arch detection,
 aio/ldbg/GL-compute guards, root check

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01V1KTZf1EfjbXMf1biK2Kv5
---
 source/lib/posix/posix_aio.h                        |  2 +-
 source/lib/sysdep/os.h                              |  2 +-
 source/lib/sysdep/os/linux/ldbg.cpp                 |  7 ++++++-
 source/main.cpp                                     |  2 +-
 source/renderer/backend/gl/DeviceCommandContext.cpp | 11 +++++++++++
 source/renderer/backend/gl/ShaderProgram.cpp        |  7 +++++++
 6 files changed, 27 insertions(+), 4 deletions(-)

diff --git a/source/lib/posix/posix_aio.h b/source/lib/posix/posix_aio.h
index 12468401..2661a2c0 100644
--- a/source/lib/posix/posix_aio.h
+++ b/source/lib/posix/posix_aio.h
@@ -30,7 +30,7 @@
 
 #if OS_WIN
 # include "lib/sysdep/os/win/wposix/waio.h"
-#elif OS_ANDROID || OS_OPENBSD
+#elif OS_ANDROID || OS_OPENBSD || defined(__EMSCRIPTEN__)
 // Android doesn't provide aio.h. We don't actually use aio on Linuxes (see
 // CONFIG2_FILE_ENABLE_AIO) but we use its symbols and structs, so define
 // them here
diff --git a/source/lib/sysdep/os.h b/source/lib/sysdep/os.h
index a958b83e..f9072398 100644
--- a/source/lib/sysdep/os.h
+++ b/source/lib/sysdep/os.h
@@ -48,7 +48,7 @@
 # define OS_WIN 0
 #endif
 // Linux
-#if defined(linux) || defined(__linux) || defined(__linux__)
+#if defined(linux) || defined(__linux) || defined(__linux__) || defined(__EMSCRIPTEN__)
 # define OS_LINUX 1
 #else
 # define OS_LINUX 0
diff --git a/source/lib/sysdep/os/linux/ldbg.cpp b/source/lib/sysdep/os/linux/ldbg.cpp
index c924fdd1..681cc58e 100644
--- a/source/lib/sysdep/os/linux/ldbg.cpp
+++ b/source/lib/sysdep/os/linux/ldbg.cpp
@@ -37,7 +37,7 @@
 #include <cstring>
 #include <sys/syscall.h>
 
-#if OS_ANDROID
+#if OS_ANDROID || defined(__EMSCRIPTEN__)
 
 // Android NDK doesn't support backtrace()
 // TODO: use unwind.h or similar?
@@ -166,6 +166,10 @@ void debug_SetThreadName(const char* name)
 	constexpr size_t MAX_THREAD_NAME_LEN = 15;
 	constexpr size_t MAX_FILE_PATH_LEN = 32;
 
+#if defined(__EMSCRIPTEN__)
+	(void)name; (void)MAX_THREAD_NAME_LEN; (void)MAX_FILE_PATH_LEN;
+	return;
+#else
 	char pathname[MAX_FILE_PATH_LEN];
 	pid_t tid = syscall(SYS_gettid);
 	snprintf(pathname, MAX_FILE_PATH_LEN, "/proc/self/task/%d/comm", tid);
@@ -177,4 +181,5 @@ void debug_SetThreadName(const char* name)
 	std::string limited_name(name, std::min(strlen(name), MAX_THREAD_NAME_LEN));
 	fputs(limited_name.c_str(), comm);
 	fclose(comm);
+#endif
 }
diff --git a/source/main.cpp b/source/main.cpp
index 39ae9084..736f7263 100644
--- a/source/main.cpp
+++ b/source/main.cpp
@@ -741,7 +741,7 @@ extern "C" __attribute__((visibility ("default"))) int main(int argc, char* argv
 
 extern "C" int main(int argc, char* argv[])
 {
-#if OS_UNIX
+#if OS_UNIX && !defined(__EMSCRIPTEN__)
 	// Don't allow people to run the game with root permissions,
 	//	because bad things can happen, check before we do anything
 	if (geteuid() == 0)
diff --git a/source/renderer/backend/gl/DeviceCommandContext.cpp b/source/renderer/backend/gl/DeviceCommandContext.cpp
index 7e8157ca..f7d79401 100644
--- a/source/renderer/backend/gl/DeviceCommandContext.cpp
+++ b/source/renderer/backend/gl/DeviceCommandContext.cpp
@@ -1258,10 +1258,16 @@ void CDeviceCommandContext::Dispatch(
 	const uint32_t groupCountZ)
 {
 	ENSURE(m_InsideComputePass);
+#if CONFIG2_GLES
+	// WebGL2 / GLES3.0 has no compute shaders.
+	ENSURE(false && "Compute dispatch is unavailable on GLES");
+	(void)groupCountX; (void)groupCountY; (void)groupCountZ;
+#else
 	glDispatchCompute(groupCountX, groupCountY, groupCountZ);
 	// TODO: we might want to do binding tracking to avoid redundant barriers.
 	glMemoryBarrier(
 		GL_SHADER_IMAGE_ACCESS_BARRIER_BIT | GL_TEXTURE_FETCH_BARRIER_BIT | GL_TEXTURE_UPDATE_BARRIER_BIT | GL_FRAMEBUFFER_BARRIER_BIT);
+#endif
 }
 
 void CDeviceCommandContext::SetTexture(const int32_t bindingSlot, ITexture* texture)
@@ -1316,9 +1322,14 @@ void CDeviceCommandContext::SetStorageTexture(const int32_t bindingSlot, ITextur
 		m_ShaderProgram->GetTextureUnit(bindingSlot);
 	if (!textureUnit.type)
 		return;
+#if CONFIG2_GLES
+	// Storage images (compute) do not exist in WebGL2.
+	ENSURE(false && "Storage textures are unavailable on GLES");
+#else
 	ENSURE(textureUnit.type == GL_IMAGE_2D);
 	ENSURE(texture->GetFormat() == Format::R8G8B8A8_UNORM);
 	glBindImageTexture(textureUnit.unit, texture->As<CTexture>()->GetHandle(), 0, GL_FALSE, 0, GL_READ_WRITE, GL_RGBA8);
+#endif
 }
 
 void CDeviceCommandContext::SetUniform(
diff --git a/source/renderer/backend/gl/ShaderProgram.cpp b/source/renderer/backend/gl/ShaderProgram.cpp
index 5c7f2731..42416144 100644
--- a/source/renderer/backend/gl/ShaderProgram.cpp
+++ b/source/renderer/backend/gl/ShaderProgram.cpp
@@ -17,6 +17,11 @@
 
 #include "precompiled.h"
 
+#if CONFIG2_GLES && !defined(GL_COMPUTE_SHADER)
+// Compute shaders do not exist in GLES3.0/WebGL2; keep the symbol so shader tables still compile.
+# define GL_COMPUTE_SHADER 0x91B9
+#endif
+
 #include "ShaderProgram.h"
 
 #include "graphics/Color.h"
@@ -675,9 +680,11 @@ public:
 			case GL_FRAGMENT_SHADER:
 				stageDefine = "STAGE_FRAGMENT";
 				break;
+#if !CONFIG2_GLES
 			case GL_COMPUTE_SHADER:
 				stageDefine = "STAGE_COMPUTE";
 				break;
+#endif
 			default:
 				break;
 			}
-- 

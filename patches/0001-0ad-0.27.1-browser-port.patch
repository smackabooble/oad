+constexpr size_t MAX_QUEUE_SIZE_FOR_OPTIMAL_UTILIZATION{12};
+
+struct BufferOutputHandler
+{
+	std::vector<u8> buffer;
+};
+
+/**
+ * Fallback for builds without NVTT (e.g. the browser build): writes an uncompressed DDS with a
+ * box-filtered mipmap chain. @p level holds BGRA (32 bit) or greyscale (8 bit) pixels.
+ */
+std::vector<u8> BuildUncompressedDDS(std::vector<u8> level, size_t w, size_t h, size_t bpp, bool mipmaps)
+{
+	const size_t bytes = bpp / 8;
+	size_t levels = 1;
+	if (mipmaps)
+		for (size_t m = std::max(w, h); m > 1; m >>= 1)
+			++levels;
+
+	std::vector<u8> out(128, 0);
+	const auto put32 = [&out](size_t offset, u32 value) { memcpy(&out[offset], &value, 4); };
+	memcpy(&out[0], "DDS ", 4);
+	put32(4, 124);
+	put32(8, 0x1 | 0x2 | 0x4 | 0x1000 | (mipmaps ? 0x20000 : 0)); // caps, height, width, pixel format, mip count
+	put32(12, static_cast<u32>(h));
+	put32(16, static_cast<u32>(w));
+	put32(28, mipmaps ? static_cast<u32>(levels) : 0);
+	put32(76, 32); // pixel format size
+	if (bytes == 4)
+	{
+		// The decoder requires R,G,B,A byte order, but the converted source is BGRA.
+		for (size_t i = 0; i + 3 < level.size(); i += 4)
+			std::swap(level[i], level[i + 2]);
+		put32(80, 0x40 | 0x1);
+		put32(88, 32);
+		put32(92, 0xFF);
+		put32(96, 0xFF00);
+		put32(100, 0xFF0000);
+		put32(104, 0xFF000000u);
+	}
+	else
+	{
+		put32(80, 0x2);
+		put32(88, 8);
+		put32(104, 0xFF);
+	}
+	put32(108, 0x1000 | (mipmaps ? (0x400000 | 0x8) : 0));
+
+	for (size_t i = 0;; ++i)
+	{
+		out.insert(out.end(), level.begin(), level.end());
+		if (i + 1 >= levels)
+			break;
+		const size_t nw = std::max<size_t>(1, w / 2);
+		const size_t nh = std::max<size_t>(1, h / 2);
+		std::vector<u8> next(nw * nh * bytes);
+		for (size_t y = 0; y < nh; ++y)
+			for (size_t x = 0; x < nw; ++x)
+				for (size_t c = 0; c < bytes; ++c)
+				{
+					unsigned sum = 0, count = 0;
+					for (size_t dy = 0; dy < 2; ++dy)
+						for (size_t dx = 0; dx < 2; ++dx)
+						{
+							const size_t sx = std::min(w - 1, x * 2 + dx), sy = std::min(h - 1, y * 2 + dy);
+							sum += level[(sy * w + sx) * bytes + c];
+							++count;
+						}
+					next[(y * nw + x) * bytes + c] = static_cast<u8>((sum + count / 2) / count);
+				}
+		level = std::move(next);
+		w = nw;
+		h = nh;
+	}
+	return out;
+}

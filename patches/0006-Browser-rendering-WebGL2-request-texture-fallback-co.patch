 	return true;
 
 #else // CONFIG2_NVTT
-	LOGERROR("Failed to convert texture \"%s\" (NVTT not available)", src.string8());
-	return false;
+	// No NVTT available: fall back to uncompressed output.
+	{
+		const size_t width = tex.m_Width, height = tex.m_Height, bpp = tex.m_Bpp;
+		const bool mipmaps = settings.mipmap == MIP_TRUE;
+		std::vector<u8> base(tex.get_data(), tex.get_data() + width * height * (bpp / 8));
+		m_ResultQueue.push(Threading::TaskManager::Instance().PushTask(
+			[dest, texture, base = std::move(base), width, height, bpp, mipmaps]() mutable
+			{
+				std::unique_ptr<ConversionResult> result = std::make_unique<ConversionResult>();
+				result->dest = dest;
+				result->texture = texture;
+				result->ret = true;
+				result->output.buffer = BuildUncompressedDDS(std::move(base), width, height, bpp, mipmaps);
+				return result;
+			}, Threading::TaskPriority::LOW));
+	}
+	return true;
 #endif // !CONFIG2_NVTT
 }
 
